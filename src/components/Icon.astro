	name === "arrow-right" && (
		<svg
			class={className}
			viewBox="4 8 16 8"
			width="24"
			height="12"
			fill="currentColor"
			aria-hidden="true"
			focusable="false"
		>
			<path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z" />
