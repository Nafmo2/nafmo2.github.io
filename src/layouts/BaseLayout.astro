---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/site";

interface Props {
	title?: string;
	description?: string;
	/** 記事ページ用の OGP 画像（サイト内パス） */
	image?: string;
	/** OGP の種類。記事ページでは article を渡す */
	type?: "website" | "article";
	/** main 要素に追加するクラス（Markdown ページの本文調整用） */
	mainClass?: string;
}

const {
	title,
	description = siteConfig.description,
	image,
	type = "website",
	mainClass,
} = Astro.props;

const siteName = siteConfig.name;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const path = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL(siteConfig.url);
const imageUrl = new URL(image ?? siteConfig.defaultOgImage, siteUrl).href;
const feedUrl = new URL("/index.xml", siteUrl).href;
const gaId = import.meta.env.PROD ? siteConfig.googleAnalyticsId : "";
const fontFamilyParam = siteConfig.fontFamily.trim().replace(/\s+/g, "+");

const navItems = [
	{ href: "/about/", label: "About" },
	{ href: "/posts/", label: "Posts" },
];
---

<!doctype html>
<html lang="ja" style={`--site-font: "${siteConfig.fontFamily}";`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var stored = null;
				try {
					stored = localStorage.getItem("theme");
				} catch (error) {}
				var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				var theme =
					stored === "light" || stored === "dark"
						? stored
						: prefersDark
							? "dark"
							: "light";
				root.dataset.theme = theme;
			})();
		</script>
		<link rel="icon" type="image/png" href="/favicon-profile.png" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteName}
			href={feedUrl}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href={`https://fonts.googleapis.com/css2?family=${fontFamilyParam}:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap`}
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={imageUrl} />
		{gaId && (
			<>
				<script
					is:inline
					async
					src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
				></script>
				<script is:inline define:vars={{ gaId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag("js", new Date());
					gtag("config", gaId);
				</script>
			</>
		)}
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="site-title" href="/">{siteName}</a>
				<div class="site-header-end">
					<nav class="site-nav" aria-label="メインメニュー">
						<ul>
							{
								navItems.map((item) => (
									<li>
										<a
											href={item.href}
											aria-current={path.startsWith(item.href) ? "page" : undefined}
										>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<button
						class="theme-toggle"
						type="button"
						data-theme-toggle
						aria-label="テーマ切替"
					>
						<Icon name="sun" class="theme-icon theme-icon-sun" />
						<Icon name="moon" class="theme-icon theme-icon-moon" />
					</button>
				</div>
			</div>
		</header>

		<main class:list={["container", mainClass]}>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>&copy; {new Date().getFullYear()} {siteName}</p>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var root = document.documentElement;
				var button = document.querySelector("[data-theme-toggle]");
				if (!button) return;

				button.addEventListener("click", function () {
					var next = root.dataset.theme === "dark" ? "light" : "dark";
					root.dataset.theme = next;
					try {
						localStorage.setItem("theme", next);
					} catch (error) {}
				});
			})();
		</script>
	</body>
</html>
